// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum RoomType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  SYSTEM_ADD_MEMBER
  SYSTEM_REMOVE_MEMBER
  SYSTEM_MEMBER_LEAVE
}

model User {
  id             String       @id @default(cuid())
  username       String       @unique
  displayName    String
  passwordHash   String
  memberships    RoomMember[]
  actorMessages  Message[]    @relation("MessageActor")
  targetMessages Message[]    @relation("MessageTarget")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model RoomMember {
  id       String     @id @default(cuid())
  room     Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     MemberRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  @@unique([roomId, userId])
  @@index([userId])
}

model Room {
  id        String       @id @default(cuid())
  type      RoomType
  dmKey     String?      @unique // sorted "userIdA:userIdB"; DIRECT rooms only, null for GROUP
  name      String?
  members   RoomMember[]
  messages  Message[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Message {
  id        String      @id @default(cuid())
  type      MessageType @default(TEXT)
  body      String?
  room      Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  actor     User?       @relation("MessageActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  target    User?       @relation("MessageTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetId  String?
  createdAt DateTime    @default(now())

  @@index([roomId, createdAt])
}
